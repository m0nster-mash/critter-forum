{
  "name": "critter_forum",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3102",
    "build": "next build",
    "start": "next start -p 3102",
    "lint": "eslint",
    "noEmit": "npx tsc --noEmit",
    "test:run": "tsx --test --experimental-test-module-mocks src/tests/*/*.test.ts",
    "alerts:check": "tsx src/scripts/alerts-check.ts && tsx scripts/logger-check.ts && tsx scripts/safe-action-check.ts && tsx scripts/toast-state-check.ts && tsx scripts/client-logger-check.ts && tsx scripts/auth-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:check": "tsx src/lib/db/check-connection.ts",
    "db:seed": "tsx src/lib/db/seed/run-seed.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait && node -e \"require('fs').rmSync('drizzle',{recursive:true,force:true})\" && npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "db:test:setup": "tsx src/scripts/db-test-setup.ts",
    "db:test:seed": "tsx src/lib/db/test/seed-test.ts",
    "db:test:run": "tsx src/scripts/db-test-run.ts",
    "db:test:reset": "tsx src/scripts/db-test-reset.ts"
  },
  "dependencies": {
    "better-auth": "1.8.0-beta.5",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.40.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
