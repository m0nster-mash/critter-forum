DATABASE_URL=postgresql://<project_user>:<project_password>@localhost:5434/<project_name>
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Logging (all optional). See docs/alerts.md.
# Server (terminal / server logs): debug | info | warn | error. Default: debug in development, info in production.
LOG_LEVEL=debug
# Server output format: pretty | json. Default: pretty in development, json in production.
LOG_FORMAT=pretty
# Browser console minimum level: debug | info | warn | error. Default: debug in development, warn in production.
# The browser console is public, so production output is always sanitized regardless of this setting.
NEXT_PUBLIC_LOG_LEVEL=debug
